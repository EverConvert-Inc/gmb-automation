# Postgres connection string (Supabase pooler URL is fine)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (location onboarding/geocoding)
GOOGLE_PLACES_API_KEY=

# Google Business Profile OAuth (per-location auth, used in v1 step 6 onward)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# DataForSEO (geo-grid scanning)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Public URL DataForSEO will postback to. Override per environment.
DATAFORSEO_POSTBACK_URL=https://your-app.vercel.app/api/scans/postback
# Shared secret appended to postback URL as ?token=... to authenticate callbacks
DATAFORSEO_POSTBACK_SECRET=

# Slack alerting
SLACK_WEBHOOK_URL=

# Resend (email alerts)
RESEND_API_KEY=

# Cron auth shared secret. Vercel cron sends this in Authorization: Bearer.
CRON_SECRET=

# Encryption key for OAuth credentials at rest (32 bytes base64)
ENCRYPTION_KEY=
