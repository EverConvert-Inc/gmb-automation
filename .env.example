# Postgres connection string (Supabase pooler URL is fine)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (location onboarding/geocoding)
GOOGLE_PLACES_API_KEY=

# Google Business Profile OAuth (per-location auth, used in v1 step 6 onward)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Google Ads customer discovery — LSA only. discoverGoogleAdsCustomers()
# normally only expands a manager (MCC) account's children if that manager
# itself shows up in the connected user's own listAccessibleCustomers()
# result. Some MCCs (e.g. a separate LSA MCC) never show up there even
# though the same refresh token can still reach their children via an
# explicit login_customer_id override. Set this to that MCC's customer id
# to make LSA's discovery probe it directly. Leave blank if unused — PPC's
# discovery is unaffected either way.
GOOGLE_ADS_LSA_MANAGER_ID=

# DataForSEO (geo-grid scanning)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Public URL DataForSEO will postback to. Override per environment.
DATAFORSEO_POSTBACK_URL=https://your-app.vercel.app/api/scans/postback
# Shared secret appended to postback URL as ?token=... to authenticate callbacks
DATAFORSEO_POSTBACK_SECRET=

# Slack alerting
SLACK_WEBHOOK_URL=

# Resend (email alerts/reports)
RESEND_API_KEY=
# Verified "from" address used by all Resend sends (PPC/LSA/Call Quality
# reports, Facebook lead notifications). Missing here even though it's
# required by existing report senders — documenting it while adding a new
# consumer of the same var.
PPC_REPORT_FROM_EMAIL=

# Facebook Lead Ads webhook (see /api/webhooks/facebook-leads)
# Shared secret Facebook sends back as hub.verify_token during webhook
# subscription setup in the Meta App Dashboard — must match exactly.
FB_WEBHOOK_VERIFY_TOKEN=
# Per-client Page Access Tokens are stored encrypted in fb_lead_clients
# (see seed:fb-lead-client), not here — no env var needed per client.

# Cron auth shared secret. Vercel cron sends this in Authorization: Bearer.
CRON_SECRET=

# Encryption key for OAuth credentials at rest (32 bytes base64)
ENCRYPTION_KEY=
